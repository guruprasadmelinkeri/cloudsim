# Optional Gemini integration. Non-AI features work without these values.
# Copy this file to .env and replace the placeholders with your own values.
# Create the API key in Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key

# Optional: pin one model ID after confirming its free-tier availability in AI Studio.
# Leave blank to discover available Gemini 3 Flash text-generation models at runtime;
# Gemini 3.0 IDs are preferred when Google exposes them to this API key.
# A model appearing in the API list does not itself confirm free-tier eligibility.
# Check models/pricing/quotas: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
